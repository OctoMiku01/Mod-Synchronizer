{
	"schemaVersion": 1,
	"id": "modsync",
	"version": "${version}",
	"name": "Mod Synchronizer",
	"description": "Keeps your mod list in sync with a shared manifest: mods come straight from Modrinth and GitHub.",
	"authors": [
		"OctoMiku01"
	],
	"contact": {
		"homepage": "https://github.com/OctoMiku01/Mod-Synchronizer",
		"sources": "https://github.com/OctoMiku01/Mod-Synchronizer",
		"issues": "https://github.com/OctoMiku01/Mod-Synchronizer/issues"
	},
	"license": "MIT",
	"icon": "assets/modsync/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"io.github.octomiku01.modsync.client.ModSyncClient"
		],
		"server": [
			"io.github.octomiku01.modsync.server.ModSyncServer"
		],
		"modmenu": [
			"io.github.octomiku01.modsync.client.ModSyncModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
